[Unit]
Description=FreeX
Documentation=https://github.com/LinzN/freex-media-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freex
Group=freex
SupplementaryGroups=video render
# systemd creates and owns /var/lib/freex-media-server (state) and /var/cache/freex-media-server (cache).
StateDirectory=freex-media-server
StateDirectoryMode=0750
CacheDirectory=freex-media-server
CacheDirectoryMode=0750
WorkingDirectory=/var/lib/freex-media-server
UMask=0027
Environment=LANG=C.UTF-8
# The SQLite driver unpacks its native library here instead of /tmp (which may be noexec).
Environment=JAVA_OPTS=-Dorg.sqlite.tmpdir=/var/cache/freex-media-server
ExecStart=/usr/bin/freex-media-server /etc/freex-media-server/config.yml
Restart=on-failure
RestartSec=5
# Java exits with 143 on SIGTERM; that is a normal stop.
SuccessExitStatus=143

# Hardening: the whole file system is read-only for the server (media folders included),
# except its state and cache directories above and its configuration (settings page).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/freex-media-server

[Install]
WantedBy=multi-user.target
